{
  "name": "school",
  "version": "1.8.0",
  "license": "MIT",
  "author": "gethugothemes",
  "scripts": {
    "dev": "export HUGO_CACHEDIR=${TMPDIR:-/tmp}/school-hugo-cache GOMODCACHE=${TMPDIR:-/tmp}/school-gomodcache GOCACHE=${TMPDIR:-/tmp}/school-gocache; hugo server --renderToMemory --baseURL /",
    "build": "export HUGO_CACHEDIR=${TMPDIR:-/tmp}/school-hugo-cache GOMODCACHE=${TMPDIR:-/tmp}/school-gomodcache GOCACHE=${TMPDIR:-/tmp}/school-gocache; hugo --gc --minify --templateMetrics --templateMetricsHints --forceSyncStatic",
    "preview": "export HUGO_CACHEDIR=${TMPDIR:-/tmp}/school-hugo-cache GOMODCACHE=${TMPDIR:-/tmp}/school-gomodcache GOCACHE=${TMPDIR:-/tmp}/school-gocache; hugo server --disableFastRender --navigateToChanged --templateMetrics --templateMetricsHints --watch --forceSyncStatic -e production --minify",
    "test": "npm run build"
  }
}
