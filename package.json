{
  "name": "ofppt-website",
  "version": "1.8.0",
  "license": "MIT",
  "author": "gethugothemes",
  "scripts": {
    "dev": "export HUGO_CACHEDIR=${TMPDIR:-/tmp}/ofppt-hugo-cache GOMODCACHE=${TMPDIR:-/tmp}/ofppt-gomodcache GOCACHE=${TMPDIR:-/tmp}/ofppt-gocache; hugo server",
    "build": "export HUGO_CACHEDIR=${TMPDIR:-/tmp}/ofppt-hugo-cache GOMODCACHE=${TMPDIR:-/tmp}/ofppt-gomodcache GOCACHE=${TMPDIR:-/tmp}/ofppt-gocache; hugo --gc --minify --templateMetrics --templateMetricsHints --forceSyncStatic",
    "preview": "export HUGO_CACHEDIR=${TMPDIR:-/tmp}/ofppt-hugo-cache GOMODCACHE=${TMPDIR:-/tmp}/ofppt-gomodcache GOCACHE=${TMPDIR:-/tmp}/ofppt-gocache; hugo server --disableFastRender --navigateToChanged --templateMetrics --templateMetricsHints --watch --forceSyncStatic -e production --minify"
  }
}
